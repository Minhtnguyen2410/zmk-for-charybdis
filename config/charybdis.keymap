#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt { require-prior-idle-ms = <100>; };

&mt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <100>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2            &kp NUMBER_3      &kp NUMBER_4    &kp N5                &kp N6               &kp N7           &kp N8             &kp N9       &kp N0      &kp BACKSLASH
&kp ESC         &lt 4 Q       &mt LS(LEFT_CONTROL) W  &kp E             &kp R           &kp T                 &kp Y                &kp U            &kp I              &kp O        &kp DELETE  &kp BACKSPACE
&kp TAB         &lt 2 A       &mt LEFT_CONTROL S      &mt LEFT_SHIFT D  &mt LEFT_ALT F  &mt LEFT_CONTROL G    &mt RIGHT_CONTROL H  &mt RIGHT_ALT J  &mt RIGHT_SHIFT K  &mt LCTRL L  &kp P       &kp ENTER
&kp LEFT_SHIFT  &lt 3 Z       &kp X                   &kp C             &kp V           &mkp MB3              &kp COMMA            &kp B            &kp N              &kp M        &tog 2      &kp RIGHT_SHIFT
                                                      &kp LEFT_SHIFT    &lt 1 SPACE     &mo 5                 &lt 2 ENTER          &lt 1 SPACE
                                                                        &kp LEFT_WIN    &kp LCTRL             &kp RIGHT_ALT
            >;
        };

        Num_Layer {
            bindings = <
&trans  &trans      &trans           &trans           &trans           &trans           &trans                 &trans         &trans            &trans             &trans     &trans
&trans  &kp KP_N0   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE    &kp RIGHT_PARENTHESIS  &kp AMPERSAND  &kp PLUS          &kp MINUS          &kp UNDER  &trans
&trans  &mo 2       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER        &kp LEFT_PARENTHESIS   &kp EQUAL      &kp ASTERISK      &kp SLASH          &kp COLON  &trans
&trans  &kp KP_DOT  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DELETE       &kp COMMA              &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &trans     &trans
                                     &trans           &trans           &trans           &trans                 &trans
                                                      &trans           &trans           &trans
            >;
        };

        cal-mouse-layer {
            bindings = <
&trans  &trans  &trans         &trans                &trans                 &trans           &trans    &trans          &trans          &trans         &trans   &trans
&trans  &trans  &kp LS(MINUS)  &kp PLUS              &kp MINUS              &kp BACKSPACE    &kp HOME  &kp PG_UP       &kp UP_ARROW    &kp PAGE_DOWN  &trans   &trans
&trans  &trans  &kp EQUAL      &kp ASTRK             &kp SLASH              &kp ENTER        &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &kp INS  &trans
&trans  &trans  &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE       &trans    &mkp MB1        &mkp MB3        &mkp MB2       &trans   &trans
                               &trans                &trans                 &trans           &trans    &trans
                                                     &trans                 &trans           &trans
            >;
        };

        sign-scroll-layer {
            bindings = <
&none   &none      &none             &none              &none          &none            &none           &none         &none         &none         &none         &none
&trans  &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp BACKSPACE    &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &none      &kp SEMICOLON     &kp SINGLE_QUOTE   &none          &kp ENTER        &none           &none         &none         &none         &none         &none
&trans  &none      &kp COMMA         &kp PERIOD         &kp SLASH      &kp DELETE       &none           &none         &none         &none         &none         &none
                                     &trans             &trans         &trans           &trans          &trans
                                                        &trans         &trans           &trans
            >;
        };

        nav-f-Snipe-Layer {
            bindings = <
&none   &none       &none        &none         &none          &none       &none   &none   &none    &none    &none    &none
&trans  &none       &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp HOME    &none   &kp F9  &kp F10  &kp F11  &kp F12  &none
&trans  &kp INSERT  &kp LEFT     &kp DOWN      &kp RIGHT      &kp END     &none   &kp F5  &kp F6   &kp F7   &kp F8   &none
&trans  &kp F9      &kp F2       &kp F4        &kp F5         &kp F8      &none   &kp F1  &kp F2   &kp F3   &kp F4   &none
                                 &trans        &trans         &trans      &trans  &trans
                                               &trans         &trans      &trans
            >;
        };

        righthand-layer {
            bindings = <
&trans  &kp NUMBER_6  &kp N7  &kp N8  &kp N9  &kp N0           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Y         &kp U   &kp I   &kp O   &kp BACKSPACE    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp H         &kp J   &kp K   &kp L   &kp P            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &kp B   &kp N   &kp M   &kp DEL          &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans           &trans  &trans
                                      &trans  &trans           &trans
            >;
        };
    };
};
