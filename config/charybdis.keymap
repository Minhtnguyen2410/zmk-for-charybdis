#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt { require-prior-idle-ms = <100>; };

&mt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <100>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2        &kp NUMBER_3      &kp NUMBER_4    &kp N5                &kp N6               &kp N7           &kp N8             &kp N9       &kp N0      &kp BACKSLASH
&kp ESC         &lt 4 Q       &kp W               &kp E             &kp R           &kp T                 &kp Y                &kp U            &kp I              &kp O        &kp DELETE  &kp BACKSPACE
&kp TAB         &kp A         &mt LEFT_CONTROL S  &mt LEFT_SHIFT D  &mt LEFT_ALT F  &mt LEFT_CONTROL G    &mt RIGHT_CONTROL H  &mt RIGHT_ALT J  &mt RIGHT_SHIFT K  &mt LCTRL L  &kp P       &kp ENTER
&kp LEFT_SHIFT  &lt 3 Z       &kp X               &kp C             &kp V           &mo 4                 &kp COMMA            &kp B            &kp N              &kp M        &mo 4       &kp RIGHT_SHIFT
                                                  &kp LEFT_SHIFT    &lt 1 SPACE     &kp BACKSPACE         &lt 2 ENTER          &lt 1 SPACE
                                                                    &kp LEFT_WIN    &kp LCTRL             &kp RIGHT_ALT
            >;
        };

        Num_Layer {
            bindings = <
&trans  &trans      &trans           &trans           &trans           &trans           &trans                 &trans         &trans            &trans             &trans     &trans
&trans  &kp KP_N0   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSPACE    &kp RIGHT_PARENTHESIS  &kp AMPERSAND  &kp PLUS          &kp MINUS          &trans     &trans
&trans  &trans      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ENTER        &kp LEFT_PARENTHESIS   &kp EQUAL      &kp ASTERISK      &kp SLASH          &kp COLON  &trans
&trans  &kp KP_DOT  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DELETE       &kp COMMA              &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &trans     &trans
                                     &trans           &trans           &trans           &trans                 &trans
                                                      &trans           &trans           &trans
            >;
        };

        F_Layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans          &trans        &trans         &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp HOME  &kp PG_UP       &kp UP_ARROW  &kp PAGE_DOWN  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp END   &kp LEFT_ARROW  &kp RIGHT     &kp RIGHT      &kp INS  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &mkp MB1        &mkp MB3      &mkp MB2       &trans   &trans
                        &trans  &trans  &trans    &trans    &trans
                                &trans  &trans    &trans
            >;
        };

        scroll-layers {
            bindings = <
&none   &none      &none             &none              &none          &none            &none           &none         &none         &none         &none         &none
&trans  &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp BACKSPACE    &bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &none      &kp SEMICOLON     &kp SINGLE_QUOTE   &none          &kp ENTER        &none           &none         &none         &none         &none         &none
&trans  &none      &kp COMMA         &kp PERIOD         &kp SLASH      &kp DELETE       &none           &none         &none         &none         &none         &none
                                     &trans             &trans         &trans           &trans          &trans
                                                        &trans         &trans           &trans
            >;
        };

        Mouse-layer {
            bindings = <
&none   &none                  &none            &none         &none                 &none     &none   &none   &none    &none    &none    &none
&trans  &kp RIGHT_PARENTHESIS  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &none     &none   &kp F9  &kp F10  &kp F11  &kp F12  &none
&trans  &none                  &kp DOLLAR       &kp PERCENT   &kp CARET             &none     &none   &kp F5  &kp F6   &kp F7   &kp F8   &none
&trans  &none                  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &none     &none   &kp F1  &kp F2   &kp F3   &kp F4   &none
                                                &trans        &trans                &trans    &trans  &trans
                                                              &none                 &none     &none
            >;
        };
    };
};
