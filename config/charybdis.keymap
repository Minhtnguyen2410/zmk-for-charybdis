#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(128,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2        &kp NUMBER_3      &kp NUMBER_4    &kp N5                &kp N6        &kp N7       &kp N8  &kp N9  &kp N0      &kp BACKSLASH
&kp ESC         &kp Q         &kp W               &kp E             &kp R           &kp T                 &kp Y         &kp U        &kp I   &kp O   &kp DELETE  &kp BACKSPACE
&kp TAB         &kp A         &mt LEFT_CONTROL S  &mt LEFT_SHIFT D  &mt LEFT_ALT F  &mt LEFT_CONTROL G    &kp H         &kp J        &kp K   &kp L   &kp P       &kp ENTER
&kp LEFT_SHIFT  &kp Z         &kp X               &kp C             &kp V           &lt 2 B               &kp COMMA     &kp B        &kp N   &kp M   &mo 4       &kp RIGHT_SHIFT
                                                  &kp LEFT_SHIFT    &lt 1 SPACE     &kp BACKSPACE         &lt 2 ENTER   &lt 1 SPACE
                                                                    &kp LEFT_WIN    &kp LEFT_CONTROL      &kp LEFT_ALT
            >;
        };

        F_layers {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans           &trans                 &trans         &trans            &trans             &trans  &trans
&trans  &kp NUMBER_0  &kp N7        &kp N8        &kp N9        &kp BACKSPACE    &kp RIGHT_PARENTHESIS  &kp AMPERSAND  &kp PLUS          &kp MINUS          &none   &trans
&trans  &mo 2         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ENTER        &kp LEFT_PARENTHESIS   &kp EQUAL      &kp ASTERISK      &kp SLASH          &none   &trans
&trans  &kp KP_DOT    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DELETE       &kp COMMA              &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &none   &trans
                                    &trans        &trans        &trans           &trans                 &trans
                                                  &trans        &trans           &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans   &trans   &trans   &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &kp F1  &kp F2   &kp F3   &kp F4   &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans     &trans            &trans             &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp GRAVE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp SEMICOLON     &kp SINGLE_QUOTE   &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &kp COMMA         &kp PERIOD         &kp SLASH      &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                     &trans             &trans         &trans    &trans  &trans
                                                        &trans         &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans          &trans       &trans    &trans         &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &kp PAGE_UP  &kp UP    &kp PAGE_DOWN  &kp HOME        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp INSERT      &kp LEFT     &kp DOWN  &kp RIGHT      &kp END         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &msc SCRL_DOWN  &mkp MB2     &mkp MB3  &mkp MB1       &msc SCRL_UP    &trans  &trans  &trans  &trans  &trans  &trans
                                     &trans    &trans         &trans          &trans  &trans
                                               &trans         &trans          &trans
            >;
        };
    };
};
